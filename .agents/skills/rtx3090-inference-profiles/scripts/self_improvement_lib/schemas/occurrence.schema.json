{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/shared/self_improvement/occurrence.schema.json",
  "title": "Self-improvement candidate occurrence",
  "type": "object",
  "required": ["id", "candidate_id", "skill_name", "pattern_key", "scope", "source_trust", "observed_at", "observation"],
  "properties": {
    "id": {"type": "string", "pattern": "^OCC-[0-9a-f]{32}$"},
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9a-f]{32}$"},
    "skill_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "pattern_key": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "scope": {"enum": ["task", "project", "user", "portable-skill"]},
    "source_trust": {"enum": ["authenticated-user", "project-owned", "external-untrusted", "tool-output", "agent-generated"]},
    "observed_at": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "additionalProperties": false
}
