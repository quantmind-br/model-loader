{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/shared/self_improvement/candidate.schema.json",
  "title": "Self-improvement learning candidate",
  "type": "object",
  "required": [
    "id", "type", "status", "skill_name", "pattern_key", "source_trust",
    "scope", "risk", "approval_required", "observed_at", "first_seen",
    "last_seen", "occurrence_count", "observation", "provenance", "hypothesis",
    "applicability", "evaluation_plan", "proposed_changes", "evidence"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CAND-[0-9a-f]{32}$"},
    "type": {"enum": ["heal", "correction", "project-fact", "technique", "feature-gap"]},
    "status": {"enum": ["candidate", "verified", "approved", "applied", "rejected", "expired"]},
    "skill_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "pattern_key": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "source_trust": {"enum": ["authenticated-user", "project-owned", "external-untrusted", "tool-output", "agent-generated"]},
    "scope": {"enum": ["task", "project", "user", "portable-skill"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "approval_required": {"const": true},
    "observed_at": {"type": "string", "minLength": 1},
    "first_seen": {"type": "string", "minLength": 1},
    "last_seen": {"type": "string", "minLength": 1},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "observation": {"type": "string", "minLength": 1, "maxLength": 4096},
    "provenance": {"type": "string", "minLength": 1, "maxLength": 4096},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4096},
    "applicability": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evaluation_plan": {"type": "string", "minLength": 1, "maxLength": 4096},
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "operation"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "operation": {"enum": ["add", "replace", "delete"]}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "sha256", "source_trust"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_trust": {"enum": ["authenticated-user", "project-owned", "external-untrusted", "tool-output", "agent-generated"]}
        },
        "additionalProperties": false
      }
    },
    "verification": {"type": "object"},
    "approvals": {"type": "array"}
  },
  "additionalProperties": false
}
