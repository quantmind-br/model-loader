{{define "base"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"timeout":10000}'>
<title>{{.Draft.Name}} · model-loader</title>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/htmx.min.js"></script>
<script defer src="/static/editor.js"></script>
<script defer src="/static/alpine.min.js"></script>
</head>
<body x-data="{mode:'configure',activeGroup:'{{if .Groups}}{{(index .Groups 0).Name}}{{end}}',search:'',dirty:false}" data-save-path="/save" data-cancel-path="/cancel"
  @input.capture="dirty=true"
  @keydown.window.prevent.ctrl.s="if(mode==='configure') document.querySelector('header .actions .primary').click()"
  @keydown.window.prevent.meta.s="if(mode==='configure') document.querySelector('header .actions .primary').click()"
  @keydown.window.escape="htmx.ajax('POST','/cancel',{})"
  @keydown.window.slash="if(mode==='configure' && document.activeElement.tagName!=='INPUT' && document.activeElement.tagName!=='SELECT' && document.activeElement.tagName!=='TEXTAREA'){$event.preventDefault(); if($refs.search) $refs.search.focus();}">
<header class="topbar">
  <div class="title">{{.Draft.Name}} <span class="muted">· {{.Draft.BackendID}}</span></div>
  <nav class="modes" role="tablist" aria-label="Editor mode">
    <button type="button" id="mode-tab-configure" role="tab" aria-controls="mode-panel-configure"
      :class="{active: mode==='configure'}" :aria-selected="mode==='configure'"
      :tabindex="mode==='configure' ? 0 : -1"
      @click="mode='configure'"
      @keydown.right.prevent="mode='customize'; $nextTick(()=>document.getElementById('mode-tab-customize').focus())"
      @keydown.left.prevent="mode='customize'; $nextTick(()=>document.getElementById('mode-tab-customize').focus())">Configure</button>
    <button type="button" id="mode-tab-customize" role="tab" aria-controls="mode-panel-customize"
      :class="{active: mode==='customize'}" :aria-selected="mode==='customize'"
      :tabindex="mode==='customize' ? 0 : -1"
      @click="mode='customize'"
      @keydown.right.prevent="mode='configure'; $nextTick(()=>document.getElementById('mode-tab-configure').focus())"
      @keydown.left.prevent="mode='configure'; $nextTick(()=>document.getElementById('mode-tab-configure').focus())">Customize</button>
  </nav>
  <div class="actions">
    <button class="ghost" hx-post="/cancel" hx-disabled-elt="this">Cancel</button>
    <button type="button" class="primary" hx-post="/save" hx-include="#profile-form" hx-target="#issues" hx-disabled-elt="this" hx-indicator="this"><span class="spinner htmx-indicator" aria-hidden="true"></span>Save</button>
  </div>
</header>
<main class="layout" :class="{'no-sidebar': mode!=='configure' || search.trim()!==''}">
  <aside class="sidebar" x-show="mode==='configure' && search.trim()===''">{{block "sidebar" .}}{{end}}</aside>
  <section class="content">
    <div x-show="mode==='configure'" role="tabpanel" id="mode-panel-configure" aria-labelledby="mode-tab-configure">{{block "configure" .}}{{end}}</div>
    <div x-show="mode==='customize'" role="tabpanel" id="mode-panel-customize" aria-labelledby="mode-tab-customize">{{block "customize" .}}{{end}}</div>
  </section>
</main>
<footer class="statusbar"><div id="issues" role="status" aria-live="polite" aria-atomic="true"><span class="ok">✓ valid</span></div></footer>
<div class="toast-root" x-data="toastHost()" x-init="init()">
  <template x-for="t in items" :key="t.id">
    <div class="toast" :class="t.type" x-text="t.msg"></div>
  </template>
</div>
</body>
</html>{{end}}
