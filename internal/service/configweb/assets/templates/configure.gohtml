{{define "sidebar"}}
<div class="sidebar-title">Grupos</div>
{{range .Groups}}
<button 
  class="tab-btn{{if .Highlighted}} hl{{end}}"
  @click="activeGroup='{{.Name}}'"
  :class="(activeGroup==='{{.Name}}' ? 'tab-btn active' : 'tab-btn') + '{{if .Highlighted}} hl{{end}}'"
>
  {{.Name}}
  <span class="count">{{len .Fields}}</span>
</button>
{{end}}
{{end}}

{{define "configure"}}
<form id="profile-form" hx-post="/validate" hx-trigger="input changed delay:300ms" hx-target="#issues">
  <input type="hidden" name="id" value="{{.Draft.ID}}">
  <input type="hidden" name="origId" value="{{.Draft.OrigID}}">
  <input type="hidden" name="isNew" value="{{if .Draft.IsNew}}true{{else}}false{{end}}">

  <div class="top-fields">
    {{if .Draft.IsNew}}
    <div class="field">
      <label>Backend</label>
      <select name="backendId" hx-post="/switch-backend" hx-target="#profile-form" hx-swap="outerHTML">
        {{range .Backends}}
        <option value="{{.ID}}"{{if eq .ID $.Draft.BackendID}} selected{{end}}>{{.Name}}</option>
        {{end}}
      </select>
    </div>
    {{else}}
    <input type="hidden" name="backendId" value="{{.Draft.BackendID}}">
    {{end}}
    <div class="field">
      <label>ID {{if not .Draft.ID}}<span class="req">*</span>{{end}}</label>
      <input name="id" value="{{.Draft.ID}}" placeholder="identificador do profile (slug)">
    </div>
    <div class="field">
      <label>Nome {{if not .Draft.Name}}<span class="req">*</span>{{end}}</label>
      <input name="name" value="{{.Draft.Name}}" placeholder="nome do profile">
    </div>
    <div class="field">
      <label>Model <span class="req">*</span></label>
      <input name="model" value="{{.Draft.Model}}" placeholder="caminho ou repo do modelo">
    </div>
  </div>

  <div class="search-box">
    <input type="text" x-model="search" placeholder="🔍 Buscar parâmetro..." class="search-input">
    <button type="button" x-show="search.length > 0" @click="search=''" class="clear-btn">×</button>
  </div>

  {{range .Groups}}
  <div x-show="search.trim()==='' ? activeGroup==='{{.Name}}' : true" x-cloak>
    <div class="group-header" x-show="search.trim()!==''">
      <h2>{{.Name}}</h2>
      <span class="badge">{{len .Fields}} opções</span>
    </div>
    <div class="fields-grid">
      {{range .Fields}}
      <div class="field{{if eq .Widget "text"}} full-width{{end}}" x-show="search.trim()==='' || fuzzyMatch(search, '{{.Flag}} {{.Label}} {{.Help}}')">
        <label>{{.Label}}{{if .Required}} <span class="req">obrigatório</span>{{end}}</label>
        {{if eq .Widget "select"}}
          {{$val := .Value}}
          <select name="arg.{{.Flag}}">
            <option value=""{{if eq $val ""}} selected{{end}}>(padrão)</option>
            {{range .Options}}<option value="{{.}}"{{if eq . $val}} selected{{end}}>{{.}}</option>{{end}}
          </select>
        {{else if eq .Widget "toggle"}}
          {{$val := .Value}}
          <select name="arg.{{.Flag}}">
            <option value=""{{if eq $val ""}} selected{{end}}>(padrão)</option>
            <option value="on"{{if eq $val "on"}} selected{{end}}>on</option>
            <option value="off"{{if eq $val "off"}} selected{{end}}>off</option>
          </select>
        {{else if eq .Widget "number"}}
          <input type="number" name="arg.{{.Flag}}" value="{{.Value}}" placeholder="{{if .Default}}{{.Default}} (padrão){{else}}não configurado{{end}}"{{if .Min}} min="{{.Min}}"{{end}}{{if .Max}} max="{{.Max}}"{{end}}>
        {{else}}
          <input name="arg.{{.Flag}}" value="{{.Value}}" placeholder="{{if .Default}}{{.Default}} (padrão){{else}}não configurado{{end}}">
        {{end}}
        {{if .Help}}<small class="muted">{{.Help}}</small>{{end}}
      </div>
      {{end}}
    </div>
  </div>
  {{end}}
</form>
{{end}}
