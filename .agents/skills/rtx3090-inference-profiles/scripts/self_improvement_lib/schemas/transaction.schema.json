{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/shared/self_improvement/transaction.schema.json",
  "title": "Self-improvement dual-copy deployment transaction journal",
  "type": "object",
  "required": ["transaction_id", "candidate_id", "state", "created_at", "targets", "journal"],
  "properties": {
    "transaction_id": {"type": "string", "pattern": "^TX-[0-9a-f]{32}$"},
    "candidate_id": {"type": "string"},
    "state": {"enum": ["prepared", "applying", "applied", "rolled-back", "conflict", "failed"]},
    "created_at": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "preimage_hash", "postimage_hash"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"},
          "preimage_hash": {"type": ["string", "null"]},
          "postimage_hash": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "journal": {"type": "array"}
  },
  "additionalProperties": true
}
