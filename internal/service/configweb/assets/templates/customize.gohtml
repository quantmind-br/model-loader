{{define "customize"}}
<div x-data="customize()">

  {{/* ── Nova Flag ── */}}
  <div class="customize-section">
    <div class="section-header">
      <h2>＋ New flag</h2>
      <span class="muted">Add a custom parameter to this backend</span>
    </div>
    <form class="flag-card flag-card-new" hx-post="/customize/flag/add">
      <input type="hidden" name="backendId" value="{{.BackendID}}">
      <div class="flag-card-body">
        <div class="flag-fields-grid">
          <div class="field">
            <label>Name (long flag) <span class="req">*</span></label>
            <input name="flag" placeholder="ex: max-tokens" required>
          </div>
          <div class="field">
            <label>Type <span class="req">*</span></label>
            <select name="type">
              <option value="string">string</option>
              <option value="int">int</option>
              <option value="float">float</option>
              <option value="bool">bool</option>
              <option value="enum">enum</option>
            </select>
          </div>
          <div class="field full-width">
            <label>Description</label>
            <input name="help" placeholder="What does this parameter control?">
          </div>
        </div>
      </div>
      <div class="flag-card-footer">
        <button class="primary" type="submit">Add flag</button>
      </div>
    </form>
  </div>

  {{/* ── Flags existentes ── */}}
  <div class="customize-section">
    <div class="section-header">
      <h2>Flags <span class="badge">{{len .AllFlags}}</span></h2>
      <span class="muted">Edit properties for each backend parameter</span>
    </div>
    <div class="flags-grid">
      {{range .AllFlags}}
      <form class="flag-card" hx-post="/customize/flag" hx-target="#issues">
        <input type="hidden" name="backendId" value="{{$.BackendID}}">
        <input type="hidden" name="flag" value="{{.Flag}}">

        <div class="flag-card-header">
          <div class="flag-name">{{.Flag}}</div>
          <div class="flag-meta">
            <span class="type-badge type-{{.Type}}">{{.Type}}</span>
            {{if .Required}}<span class="req-badge">required</span>{{end}}
            {{if .Default}}<span class="default-badge">default: {{.Default}}</span>{{end}}
          </div>
        </div>

        <div class="flag-card-body">
          <div class="flag-fields-grid">
            <div class="field">
              <label>Type</label>
              <select name="type">
                <option value="int"{{if eq .Type "int"}} selected{{end}}>int</option>
                <option value="float"{{if eq .Type "float"}} selected{{end}}>float</option>
                <option value="bool"{{if eq .Type "bool"}} selected{{end}}>bool</option>
                <option value="enum"{{if eq .Type "enum"}} selected{{end}}>enum</option>
                <option value="string"{{if eq .Type "string"}} selected{{end}}>string</option>
              </select>
            </div>
            <div class="field">
              <label>Min</label>
              <input name="min" placeholder="min" value="{{.Min}}">
            </div>
            <div class="field">
              <label>Max</label>
              <input name="max" placeholder="max" value="{{.Max}}">
            </div>
            <div class="field">
              <label>Default</label>
              <input name="default" placeholder="default" value="{{.Default}}">
            </div>
            <div class="field full-width">
              <label>Enum values (csv)</label>
              <input name="enumValues" placeholder="ex: f16, q4_0, q8_0" value="{{.Enum}}">
            </div>
            <div class="field full-width">
              <label class="toggle-label">
                <input type="checkbox" name="required"{{if .Required}} checked{{end}}>
                <span>Required</span>
              </label>
            </div>
          </div>
        </div>

        <div class="flag-card-footer">
          <button class="primary" type="submit">Save</button>
          <button class="ghost danger" type="button"
            hx-post="/customize/flag/remove" hx-vals='{"backendId":"{{$.BackendID}}","flag":"{{.Flag}}"}'>Remove</button>
        </div>
      </form>
      {{end}}
    </div>
  </div>

  {{/* ── Rules ── */}}
  <div class="customize-section">
    <div class="section-header">
      <h2>Cross-field rules <span class="badge" x-text="rules.length">{{len .Rules}}</span></h2>
      <span class="muted">Conditional validations: if a flag has value X, then require/limit/another</span>
    </div>

    <div class="rules-list">
      <template x-for="(rule,i) in rules" :key="i">
        <div class="rule-card">
          <div class="rule-header">
            <span class="rule-number" x-text="'#'+(i+1)"></span>
            <button class="ghost danger" type="button" @click="rules.splice(i,1)">Remove</button>
          </div>
          <div class="rule-body">
            <div class="rule-when">
              <span class="rule-keyword">IF</span>
              <input x-model="rule.when.flag" placeholder="flag" size="12">
              <select x-model="rule.when.op">
                <option value="eq">=</option>
                <option value="ne">≠</option>
                <option value="le">≤</option>
                <option value="ge">≥</option>
              </select>
              <input x-model="rule.when.value" placeholder="value" size="8">
            </div>
            <div class="rule-then">
              <span class="rule-keyword">THEN</span>
              <select x-model="rule.then.kind">
                <option value="limit">limit</option>
                <option value="require">require</option>
                <option value="message">message</option>
              </select>
              <input x-model="rule.then.flag" placeholder="target field" size="12" x-show="rule.then.kind!=='message'">
              <select x-model="rule.then.op" x-show="rule.then.kind==='limit'">
                <option value="le">≤</option>
                <option value="ge">≥</option>
                <option value="eq">=</option>
                <option value="ne">≠</option>
              </select>
              <input x-model="rule.then.value" placeholder="value" size="8" x-show="rule.then.kind!=='message'">
              <input x-model="rule.then.message" placeholder="message to user" size="24" x-show="rule.then.kind==='message'">
            </div>
            <div class="rule-meta">
              <span class="muted">Severity:</span>
              <select x-model="rule.severity">
                <option value="warning">warning</option>
                <option value="error">error</option>
              </select>
            </div>
          </div>
        </div>
      </template>
    </div>

    <div class="rules-actions">
      <button class="ghost" type="button" @click="addRule()">＋ New rule</button>
      <button class="primary" type="button" @click="saveRules()">Save all rules</button>
    </div>
  </div>

  <script>
    function customize(){return{
      rules: {{if .Rules}}{{.Rules | toJSON}}{{else}}[]{{end}},
      backendId: "{{.BackendID}}",
      addRule(){this.rules.push({id:crypto.randomUUID(),when:{flag:'',op:'eq',value:''},then:{kind:'message',message:''},severity:'warning'})},
      async saveRules(){
        const r=await fetch('/customize/rules?backendId='+encodeURIComponent(this.backendId),
          {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(this.rules)});
        if(!r.ok){alert(await r.text())}
      }
    }}
  </script>
</div>
{{end}}
